<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mankuro_background">

    <!-- CABECERA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/mankuro_surface">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/three_bars"
            android:contentDescription="@string/three_bars"
            android:tint="@color/mankuro_text"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Boton para cerrar sesion -->
        <ImageView
            android:id="@+id/btnLogout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/logout"
            android:contentDescription="@string/log_out"
            android:tint="@color/mankuro_text"
            android:clickable="true"
            android:focusable="true"
            android:padding="2dp" />

    </LinearLayout>

    <!-- SALUDO CENTRADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:background="@color/mankuro_surface">

        <TextView
            android:id="@+id/txtGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hello"
            android:textColor="@color/mankuro_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome"
            android:textColor="@color/mankuro_text_secondary"
            android:textSize="15sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- CONTENIDO CENTRAL VACIO -->
    <FrameLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/mankuro_background" />

    <!-- BARRA DE NAVEGACION INFERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/mankuro_surface"
        android:elevation="8dp"
        android:paddingHorizontal="4dp">

        <!-- BIBLIOTECA -->
        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/nav_library_desc">

            <ImageView
                android:id="@+id/btnLibrary"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/library"
                android:contentDescription="@string/nav_library_desc"
                android:tint="@color/mankuro_text"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_library"
                android:textSize="11sp"
                android:textColor="@color/mankuro_primary" />

        </LinearLayout>

        <!-- EXPLORAR -->
        <LinearLayout
            android:id="@+id/navExplore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/nav_explore_desc">

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/search"
                android:contentDescription="@string/nav_explore_desc"
                android:tint="@color/mankuro_text"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_explore"
                android:textSize="11sp"
                android:textColor="@color/mankuro_primary" />

        </LinearLayout>

        <!-- COMUNIDAD -->
        <LinearLayout
            android:id="@+id/navCommunity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/nav_community_desc">

            <ImageView
                android:id="@+id/btnCommunity"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/community"
                android:contentDescription="@string/nav_community_desc"
                android:tint="@color/mankuro_text"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_community"
                android:textSize="11sp"
                android:textColor="@color/mankuro_primary" />

        </LinearLayout>

        <!-- PERFIL -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/nav_profile_desc">

            <ImageView
                android:id="@+id/btnProfile"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/profile"
                android:contentDescription="@string/nav_profile_desc"
                android:tint="@color/mankuro_text"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_profile"
                android:textSize="11sp"
                android:textColor="@color/mankuro_primary" />

        </LinearLayout>

        <!-- AJUSTES -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/nav_settings_desc">

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/settings"
                android:contentDescription="@string/nav_settings_desc"
                android:tint="@color/mankuro_text"
                android:clickable="true"
                android:focusable="true"
                android:padding="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings"
                android:textSize="11sp"
                android:textColor="@color/mankuro_primary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

