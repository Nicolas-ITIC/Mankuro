<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mankuro_background">

    <!-- Cabecera -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnCommunityBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/arrow_back"
            android:contentDescription="@string/community_back"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:tint="@color/mankuro_text" />

        <TextView
            android:id="@+id/tvCommunityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/community_title"
            android:textColor="@color/mankuro_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCommunitySearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/search"
            android:contentDescription="@string/community_search"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:tint="@color/mankuro_text" />

    </RelativeLayout>

    <!-- Pestañas: Siguiendo y Para ti -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvCommunityFollowing"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/community_following"
            android:textColor="@color/mankuro_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvCommunityForYou"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/community_for_you"
            android:textColor="@color/mankuro_text"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mankuro_border" />

    <!-- Lista de publicaciones -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCommunityPosts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Crear publicación -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mankuro_border" />

    <LinearLayout
        android:id="@+id/btnCreatePost"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@color/mankuro_surface">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/add"
            android:contentDescription="@string/community_create_post"
            android:tint="@color/mankuro_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/community_create_post"
            android:textColor="@color/mankuro_text"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
