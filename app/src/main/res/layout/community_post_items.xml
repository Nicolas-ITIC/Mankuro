<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:background="@color/mankuro_background">

    <!-- Usuario de la publicación -->
    <TextView
        android:id="@+id/tvPostAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/community_sample_author"
        android:textColor="@color/mankuro_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Texto del post -->
    <TextView
        android:id="@+id/tvPostDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/community_sample_description"
        android:textColor="@color/mankuro_text"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />

    <!-- Imagen opcional del post -->
    <ImageView
        android:id="@+id/ivPostImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        android:background="@color/mankuro_surface"
        android:contentDescription="@string/community_post_image_desc"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery" />

    <!-- Me gusta y comentarios -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivPostLike"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/heart"
            android:contentDescription="@string/community_like"
            android:tint="@color/mankuro_accent" />

        <TextView
            android:id="@+id/tvPostLikes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/community_sample_likes"
            android:textColor="@color/mankuro_text_secondary"
            android:textSize="13sp" />

        <Space
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <ImageView
            android:id="@+id/ivPostComments"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/comment"
            android:contentDescription="@string/community_comments"
            android:tint="@color/mankuro_text_secondary" />

        <TextView
            android:id="@+id/tvPostComments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/community_sample_comments"
            android:textColor="@color/mankuro_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/mankuro_border" />

</LinearLayout>
