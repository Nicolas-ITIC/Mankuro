
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@color/mankuro_surface">

    <!-- Portada -->
    <ImageView
        android:id="@+id/ivExploreResultCover"
        android:layout_width="70dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery"
        android:contentDescription="@string/library_cover_desc" />

    <!-- Título, tipo y capítulos -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvExploreResultTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/explore_sample_title"
            android:textColor="@color/mankuro_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvExploreResultType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/explore_sample_type"
            android:textColor="@color/mankuro_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvExploreResultProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/explore_sample_progress"
            android:textColor="@color/mankuro_primary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Score global -->
    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/explore_score_label"
            android:textColor="@color/mankuro_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvExploreResultScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/explore_sample_score"
            android:textColor="@color/mankuro_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
