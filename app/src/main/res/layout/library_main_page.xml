<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btnLibraryBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/arrow_back"
            android:contentDescription="@string/arrow_back"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/on_background" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/library_title"
            android:textColor="@color/on_background"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/btnLibraryAdd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/add"
            android:contentDescription="@string/library_add_item"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/on_background" />

        <ImageView
            android:id="@+id/btnLibraryFilters"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/filter"
            android:contentDescription="@string/library_filters"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/on_background" />

    </LinearLayout>

    <!-- Lista de mangas y manhwas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLibrary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:paddingTop="12dp"
            android:paddingBottom="88dp"
            tools:itemCount="3"
            tools:listitem="@layout/library_items" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddWork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/library_add_desc"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/primary"
            app:tint="@color/on_primary" />

    </FrameLayout>

</LinearLayout>
