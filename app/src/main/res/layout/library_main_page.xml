<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mankuro_background"
    android:padding="16dp">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btnLibraryBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/arrow_back"
            android:contentDescription="@string/arrow_back"
            android:tint="@color/mankuro_text"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/library_title"
            android:textColor="@color/mankuro_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/btnLibraryFilters"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/filter"
            android:contentDescription="@string/library_filters"
            android:tint="@color/mankuro_text"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Lista de mangas y manhwas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibrary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:overScrollMode="ifContentScrolls" />

</LinearLayout>
