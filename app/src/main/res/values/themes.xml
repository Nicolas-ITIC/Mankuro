<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- DayNight: oscuro por defecto (values/); el claro está en values-notnight/ -->
    <style name="Theme.Mankuro" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Colors de marca -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Fons i superficies -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Errors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- Text per defecte -->
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
        <item name="android:textColorHint">@color/on_surface_variant</item>

        <!-- Finestres i barres del sistema -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <!-- Icones fosques a les barres quan el fons és clar (true en clar, false en fosc) -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_system_bars</item>

        <!-- Estils per defecte dels components (definits a styles.xml) -->
        <item name="materialButtonStyle">@style/Widget.Mankuro.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Mankuro.Card</item>
        <item name="textInputStyle">@style/Widget.Mankuro.TextInputLayout</item>

    </style>

    <!-- SplashScreen -->
    <style name="Theme.Mankuro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/mankuro_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Mankuro</item>
    </style>

    <!-- Theme de Alto Contraste: sempre fons negre, també en mode clar -->
    <style name="Theme.Mankuro.HighContrast" parent="Theme.Mankuro">
        <item name="android:colorBackground">@color/hc_background</item>
        <item name="android:windowBackground">@color/hc_background</item>
        <item name="android:statusBarColor">@color/hc_background</item>
        <item name="android:navigationBarColor">@color/hc_background</item>
        <!-- Fons negre => icones de les barres sempre clares (no heredar el valor del mode clar) -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="colorSurface">@color/hc_surface</item>
        <item name="colorOnBackground">@color/hc_on_background</item>
        <item name="colorOnSurface">@color/hc_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/hc_on_surface_variant</item>
        <item name="android:textColorPrimary">@color/hc_on_surface</item>
        <item name="android:textColorSecondary">@color/hc_on_surface_variant</item>
        <item name="android:textColorHint">@color/hc_text_hint</item>
        <item name="colorPrimary">@color/hc_primary</item>
        <item name="colorSecondary">@color/hc_secondary</item>
    </style>

</resources>